{
  "search.exclude": {
    "**/.next": true,
    "**/dist": true,
    "**/node_modules": false,
    "**/node_modules/**": true,
    "**/vendor": true
  },

  // ===== Todo Tree 插件配置 =====
  "todo-tree.general.statusBar": "total",
  "todo-tree.general.tags": ["BUG", "NOTE", "FIXME", "TODO", "HACK"],
  "todo-tree.highlights.useColourScheme": true,
  "todo-tree.tree.expanded": true,
  "todo-tree.tree.groupedByTag": true,
  "todo-tree.tree.showCountsInTree": true,
  "todo-tree.tree.tagsOnly": false,
  "todo-tree.tree.disableCompactFolders": true,
  "todo-tree.tree.scanMode": "workspace only",
  "todo-tree.tree.buttons.export": true,

  // ===== 文件排除显示 =====
  "files.exclude": {
    "**/trans/**/*test.go": true,
    ".husky": true,
    ".github": true,
    "node_modules": true,
    "certificate.pem": true,
    "ttpos-flutter": true,
    "certificate": true,
  },

  // ===== 拼写检查 =====
  "cSpell.language": "en",  // 只检查英语
  "cSpell.allowCompoundWords": true,  // 允许复合词
  "cSpell.ignorePaths": [
    "node_modules",
    "vendor",
    "*.json",
    "*.lock"
  ],
  "cSpell.ignoreRegExpList": [
    "/([\u4e00-\u9fa5])+/g",           // 忽略中文
    "/([\u0E00-\u0E7F])+/g",           // 忽略泰文
    "/([\u1000-\u109F])+/g",           // 忽略缅甸文
    "/([\u0600-\u06FF])+/g",           // 忽略阿拉伯文
    "/([\u0080-\u024F])+/g",           // 忽略拉丁扩展字符(土耳其语、瑞典语等)
    "/\"[^\"]*[\\u0080-\\uFFFF][^\"]*\"/g"  // 忽略包含非ASCII字符的字符串
  ],
  "cSpell.words": [
    "biginteger","Boms","Codesoft","Compax","cryptor","CSSH","CSSQ","delayqueue",
    "destek","ederiz","Erpnext","eventbus","gonic","gorm","gormio","Graphiti","grpcx","Howbest","için","IFNULL","IMIN",
    "Immin","iptal","jinzhu","lianlian","mağaza","Phinx","Printnr","Qrcode","repassword","sağlar","shopspring","SHRK","Sistem",
    "skootar","Sunmi","tarafından","teşekkür","tinyint","TPHY","Tpls","ttpos","uoms","Uoms","varchar","Wechat","Xprinter",
    "zhtw","Zhuhai","Ziyaretiniz", "apikey","gpath","NACOS","LOCAL_IP","ROCKETMQ",
    "elif","reqs","nobackup","unagent","BUILDKIT","hitosea","buildx",
    "gogf","gerror","ghttp","upgrader","Upgrader","lianlianpay",
    "Adat","Antal","betalningar","Betalningsmetod","Bord","Bordsorderbelopp","Detaljerad","Detaylar","Dilimi",
    "excelize","Genomsnittlig","GOARCH","Kategori","Konsumerade","letme","lista","Matleveranstid",
    "Maträttsdetaljer","matråttsutbud","Miktar","mottagna","Namn","över","Produktionstid","Rapor","rsdag",
    "Sammanfattning","specifikation","Sunumu","swaggo","Tamamlanan","Tidsperiod","xuri","Yemek","Zaman",
    "Adet","maträttsutbud",
  ],

  // ===== Go语言配置 =====
  "gopls": {
    "ui.diagnostic.staticcheck": false // 禁用静态分析检查
  },

  // ===== 保存时自动运行 =====
  "go.lintOnSave": "workspace",

  // ===== 远程管理端口自动转发 =====
  "remote.autoForwardPorts": true,
  "remote.autoForwardPortsSource": "process",
  "remote.forwardOnOpen": true,
  "remote.restoreForwardedPorts": true,
  "remote.localPortHost": "allInterfaces",
  "remote.portsAttributes": {
    "1-65378": {
      "label": "忽略",
      "onAutoForward": "ignore"
    },
    "8080": {
      "label": "Go API服务(dev)",
      "onAutoForward": "silent",
      "protocol": "http"
    },
    "8888": {
      "label": "TTPOS主服务",
      "onAutoForward": "silent",
      "protocol": "http"
    },
    "8082": {
      "label": "RocketMQ Dashboard",
      "onAutoForward": "silent",
      "protocol": "http"
    },
    "18080": {
      "label": "Nacos",
      "onAutoForward": "silent",
      "protocol": "http"
    },
    "3306": {
      "label": "MySQL服务",
      "onAutoForward": "silent"
    },
    "13306": {
      "label": "MySQL服务",
      "onAutoForward": "silent"
    },
    "6379": {
      "label": "Redis服务",
      "onAutoForward": "silent"
    },
    "8091": {
      "label": "HTTP检测服务",
      "onAutoForward": "silent"
    },
    "8079": {
      "label": "HTTP检测服务",
      "onAutoForward": "silent"
    }
  }
}
