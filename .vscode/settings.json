        },
        "9000-11010": {
            "label": "忽略",
            "onAutoForward": "ignore"
        },
        "13337-18080": {
            "label": "忽略",
            "onAutoForward": "ignore"
        },
        "20000-65378": {
            "label": "忽略",
            "onAutoForward": "ignore"
        }
    }
  }