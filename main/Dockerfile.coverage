# TTPOS Server with Coverage Instrumentation
# ==========================================
# This Dockerfile builds the Go service with coverage instrumentation.
# The coverage data will be written to GOCOVERDIR environment variable.

FROM golang:1.23 AS builder

# Copy BMP module API definitions
WORKDIR /ttpos-bmp
COPY ttpos-bmp/go.mod ttpos-bmp/go.sum ./
COPY ttpos-bmp/app/ttpos-takeout/api app/ttpos-takeout/api
COPY ttpos-bmp/app/ttpos-erp/api app/ttpos-erp/api
COPY ttpos-bmp/app/ttpos-shop/api app/ttpos-shop/api
COPY ttpos-bmp/app/ttpos-manager/api app/ttpos-manager/api
COPY ttpos-bmp/app/ttpos-message/api app/ttpos-message/api
COPY ttpos-bmp/app/ttpos-websocket/api app/ttpos-websocket/api

# Copy ttpos-api module
WORKDIR /ttpos-api
COPY ttpos-api/ ./

# Setup main application
WORKDIR /app
COPY main/go.mod main/go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY main .

# Build with coverage instrumentation
# -cover: Enable coverage collection
# Note: Removed -a flag to allow incremental builds (cache-friendly)
#       Use -a only when you need to rebuild everything (e.g., major dependency changes)
# -ldflags="-s -w": Strip debug info for smaller binary
RUN go build -cover -ldflags="-s -w" -o main ./main.go

# Add execute permission
RUN chmod +x main

# Runtime image
FROM ubuntu:latest

# Install runtime dependencies
RUN apt-get update && apt-get install -y ca-certificates curl && \
    apt-get clean && apt-get autoclean && apt-get autoremove --yes && \
    rm -rf /var/lib/{apt,dpkg,cache,log}/

WORKDIR /var/www

# Copy binary
COPY --from=builder /app/main .

# Copy i18n directory for language files
COPY --from=builder /app/i18n /var/www/i18n

# Create coverage directory
RUN mkdir -p /coverage

# Create empty .env file for integration tests (config expects ../.env from /var/www = /var/.env)
RUN touch /var/.env

# Expose application port
EXPOSE 8080

# Run the application
# Note: GOCOVERDIR should be set via environment variable
CMD ["./main"]
