<?php
namespace app\admin\middleware;

use Closure;
use think\Request;
use think\Response;

/**
 * 权限验证中间件
 */
class AuthMiddleware
{
    /**
     * 处理请求
     * @param Request $request
     * @param Closure $next
     * @return Response
     */
    public function handle(Request $request, Closure $next)
    {
        // 获取token
        $token = $request->header('Authorization');
        
        // 验证token
        if (empty($token)) {
            return json([
                'code' => 401,
                'message' => '未登录',
                'data' => (object)[],
            ]);
        }
        
        // 解析token并验证权限
        // ...
        
        // 继续执行
        return $next($request);
    }
}
```

