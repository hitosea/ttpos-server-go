## 最佳实践

### 1. 性能优化

✅ **使用 v-show 和 v-if**
```vue
<!-- 频繁切换使用 v-show -->
<div v-show="isVisible">内容</div>

<!-- 条件很少改变使用 v-if -->
<div v-if="isAdmin">管理员内容</div>
```

✅ **使用 computed 缓存计算结果**
```typescript
// ✅ 使用 computed
const filteredList = computed(() => {
  return list.value.filter(item => item.status === 1);
});

// ❌ 使用方法（每次都重新计算）
const getFilteredList = () => {
  return list.value.filter(item => item.status === 1);
};
```

### 2. 代码复用

✅ **使用 Composables**
```typescript
// composables/useTable.ts
export const useTable = () => {
  const tableData = ref([]);
  const loading = ref(false);
  const pagination = ref({
    page: 1,
    pageSize: 20,
    total: 0,
  });

  const getTableData = async (api: Function) => {
    try {
      loading.value = true;
      const res = await api(pagination.value);
      tableData.value = res.data.list;
      pagination.value.total = res.data.meta.total;
    } finally {
      loading.value = false;
    }
  };

  return {
    tableData,
    loading,
    pagination,
    getTableData,
  };
};
```

### 3. 类型安全

✅ **定义完整的类型**
```typescript
// types/api.d.ts
export interface User {
  id: number;
  uuid: number;
  username: string;
  email: string;
  status: number;
  createTime: number;
}

export interface UserListParams {
  page: number;
  page_size: number;
  keyword?: string;
}

export interface UserListResponse {
  code: number;
  message: string;
  data: {
    list: User[];
    meta: {
      page_no: number;
      page_size: number;
      total: number;
    };
  };
}
```

