## 命名规范

### 1. 文件命名

✅ **正确**: 使用大驼峰命名（PascalCase）
```
UserList.vue          # 页面组件
UserForm.vue          # 表单组件
CommonButton.vue      # 通用组件
TablePagination.vue   # 表格分页组件
```

❌ **错误**:
```
userList.vue          # ❌ 小驼峰
user-list.vue         # ❌ 烤串命名
user_list.vue         # ❌ 下划线
```

### 2. 组件命名

✅ **正确**: 使用大驼峰命名
```vue
<template>
  <UserList />
  <CommonButton />
</template>

<script setup lang="ts">
import UserList from './UserList.vue';
import CommonButton from '@/components/Common/CommonButton.vue';
</script>
```

### 3. 变量和函数命名

✅ **正确**: 使用小驼峰命名（camelCase）
```typescript
const userName = ref('');
const userList = ref([]);
const isLoading = ref(false);

const getUserList = async () => {
  // ...
};

const handleSubmit = () => {
  // ...
};
```

### 4. 常量命名

✅ **正确**: 使用全大写+下划线
```typescript
const MAX_PAGE_SIZE = 100;
const API_BASE_URL = 'https://api.example.com';
const ORDER_STATUS_MAP = {
  PENDING: 0,
  PAID: 1,
  COMPLETED: 2,
};
```

## 组件开发

### 1. 使用 Composition API

✅ **正确**: 使用 `<script setup>` 语法
```vue
<template>
  <div class="user-list">
    <el-table :data="userList" :loading="loading">
      <el-table-column prop="username" label="用户名" />
      <el-table-column prop="email" label="邮箱" />
      <el-table-column label="操作">
        <template #default="{ row }">
          <el-button @click="handleEdit(row)">编辑</el-button>
          <el-button @click="handleDelete(row)">删除</el-button>
        </template>
      </el-table-column>
    </el-table>
  </div>
</template>

<script setup lang="ts">
import { ref, onMounted } from 'vue';
import { getUserListApi } from '@/api/user';
import type { User } from '@/types/api';

// 响应式数据
const userList = ref<User[]>([]);
const loading = ref(false);

// 获取用户列表
const getUserList = async () => {
  try {
    loading.value = true;
    const res = await getUserListApi();
    userList.value = res.data.list;
  } catch (error) {
    console.error('获取用户列表失败:', error);
  } finally {
    loading.value = false;
  }
};

// 编辑用户
const handleEdit = (row: User) => {
  // 编辑逻辑
};

// 删除用户
const handleDelete = (row: User) => {
  // 删除逻辑
};

// 生命周期
onMounted(() => {
  getUserList();
});
</script>

<style scoped lang="scss">
.user-list {
  padding: 20px;
}
</style>
```

❌ **错误**: 不要使用 Options API
```vue
<script>
export default {
  data() {
    return {
      userList: [],
    };
  },
  methods: {
    getUserList() {
      // ...
    },
  },
};
</script>
```

### 2. Props 和 Emits 定义

✅ **正确**: 使用 TypeScript 类型定义
```vue
<script setup lang="ts">
// Props定义
interface Props {
  userId: number;
  userName?: string;
  disabled?: boolean;
}

const props = withDefaults(defineProps<Props>(), {
  userName: '',
  disabled: false,
});

// Emits定义
interface Emits {
  (e: 'update', value: string): void;
  (e: 'delete', id: number): void;
}

const emit = defineEmits<Emits>();

// 使用
const handleUpdate = (value: string) => {
  emit('update', value);
};
</script>
```

### 3. 组件拆分

✅ **遵循单一职责原则**
```vue
<!-- ❌ 错误：一个组件做太多事情 -->
<template>
  <div>
    <!-- 表单 -->
    <el-form>...</el-form>
    <!-- 表格 -->
    <el-table>...</el-table>
    <!-- 分页 -->
    <el-pagination>...</el-pagination>
  </div>
</template>

<!-- ✅ 正确：拆分成多个组件 -->
<template>
  <div>
    <UserForm @submit="handleSubmit" />
    <UserTable :data="userList" @edit="handleEdit" />
    <TablePagination v-model="pagination" @change="getUserList" />
  </div>
</template>
```

## 状态管理

### 1. 使用 Pinia

✅ **正确的 Store 定义**
```typescript
// stores/user.ts
import { defineStore } from 'pinia';
import { ref, computed } from 'vue';
import type { User } from '@/types/api';

export const useUserStore = defineStore('user', () => {
  // State
  const userInfo = ref<User | null>(null);
  const token = ref('');

  // Getters
  const isLogin = computed(() => !!token.value);
  const userName = computed(() => userInfo.value?.username || '');

  // Actions
  const setUserInfo = (user: User) => {
    userInfo.value = user;
  };

  const setToken = (newToken: string) => {
    token.value = newToken;
    localStorage.setItem('token', newToken);
  };

  const logout = () => {
    userInfo.value = null;
    token.value = '';
    localStorage.removeItem('token');
  };

  return {
    userInfo,
    token,
    isLogin,
    userName,
    setUserInfo,
    setToken,
    logout,
  };
});
```

### 2. 使用 Store

✅ **在组件中使用**
```vue
<script setup lang="ts">
import { useUserStore } from '@/stores/user';

const userStore = useUserStore();

// 访问状态
console.log(userStore.userName);
console.log(userStore.isLogin);

// 调用方法
const handleLogout = () => {
  userStore.logout();
};
</script>
```

## API调用

### 1. API 封装

✅ **正确的 API 封装**
```typescript
// utils/request.ts
import axios from 'axios';
import type { AxiosInstance, AxiosRequestConfig, AxiosResponse } from 'axios';
import { ElMessage } from 'element-plus';

// 创建axios实例
const service: AxiosInstance = axios.create({
  baseURL: import.meta.env.VITE_API_BASE_URL,
  timeout: 15000,
});

// 请求拦截器
service.interceptors.request.use(
  (config) => {
    // 添加token
    const token = localStorage.getItem('token');
    if (token) {
      config.headers.Authorization = `Bearer ${token}`;
    }
    return config;
  },
  (error) => {
    return Promise.reject(error);
  }
);

// 响应拦截器
service.interceptors.response.use(
  (response: AxiosResponse) => {
    const res = response.data;
    
    // 根据code判断
    if (res.code !== 1) {
      ElMessage.error(res.message || '请求失败');
      return Promise.reject(new Error(res.message || '请求失败'));
    }
    
    return res;
  },
  (error) => {
    ElMessage.error(error.message || '网络错误');
    return Promise.reject(error);
  }
);

export default service;
```

### 2. API 定义

✅ **正确的 API 定义**
```typescript
// api/user.ts
import request from '@/utils/request';
import type { User, UserListParams, UserListResponse } from '@/types/api';

/**
 * 获取用户列表
 */
export const getUserListApi = (params: UserListParams) => {
  return request<UserListResponse>({
    url: '/api/v1/admin/user/list',
    method: 'get',
    params,
  });
};

/**
 * 创建用户
 */
export const createUserApi = (data: Partial<User>) => {
  return request({
    url: '/api/v1/admin/user/create',
    method: 'post',
    data,
  });
};

/**
 * 更新用户
 */
export const updateUserApi = (id: number, data: Partial<User>) => {
  return request({
    url: `/api/v1/admin/user/${id}`,
    method: 'put',
    data,
  });
};

/**
 * 删除用户
 */
export const deleteUserApi = (id: number) => {
  return request({
    url: `/api/v1/admin/user/${id}`,
    method: 'delete',
  });
};
```

### 3. 在组件中调用

✅ **使用 try-catch 处理**
```vue
<script setup lang="ts">
import { ref } from 'vue';
import { getUserListApi } from '@/api/user';
import { ElMessage } from 'element-plus';

const userList = ref([]);
const loading = ref(false);

// ✅ 正确：使用 try-catch
const getUserList = async () => {
  try {
    loading.value = true;
    const res = await getUserListApi({ page: 1, page_size: 20 });
    userList.value = res.data.list;
  } catch (error) {
    console.error('获取用户列表失败:', error);
    ElMessage.error('获取用户列表失败');
  } finally {
    loading.value = false;
  }
};

// ❌ 错误：使用 .then().catch()
const getUserListOld = () => {
  getUserListApi({ page: 1, page_size: 20 })
    .then((res) => {
      userList.value = res.data.list;
    })
    .catch((error) => {
      console.error(error);
    });
};
</script>
```

## 路由管理

### 1. 路由定义

✅ **正确的路由配置**
```typescript
// router/index.ts
import { createRouter, createWebHistory } from 'vue-router';
import type { RouteRecordRaw } from 'vue-router';

const routes: RouteRecordRaw[] = [
  {
    path: '/',
    component: () => import('@/layouts/Default.vue'),
    redirect: '/home',
    children: [
      {
        path: 'home',
        name: 'Home',
        component: () => import('@/views/home/Index.vue'),
        meta: {
          title: '首页',
          icon: 'home',
        },
      },
      {
        path: 'user',
        name: 'User',
        component: () => import('@/views/user/Index.vue'),
        meta: {
          title: '用户管理',
          icon: 'user',
        },
        children: [
          {
            path: 'list',
            name: 'UserList',
            component: () => import('@/views/user/List.vue'),
            meta: {
              title: '用户列表',
            },
          },
        ],
      },
    ],
  },
  {
    path: '/login',
    name: 'Login',
    component: () => import('@/views/login/Index.vue'),
    meta: {
      title: '登录',
    },
  },
];

const router = createRouter({
  history: createWebHistory(),
  routes,
});

export default router;
```

### 2. 路由守卫

✅ **添加权限验证**
```typescript
// router/index.ts
import { useUserStore } from '@/stores/user';

router.beforeEach((to, from, next) => {
  const userStore = useUserStore();
  
  // 设置页面标题
  document.title = to.meta.title as string || '管理后台';
  
  // 白名单
  const whiteList = ['/login'];
  
  if (userStore.isLogin) {
    // 已登录
    if (to.path === '/login') {
      next('/');
    } else {
      next();
    }
  } else {
    // 未登录
    if (whiteList.includes(to.path)) {
      next();
    } else {
      next('/login');
    }
  }
});
```

