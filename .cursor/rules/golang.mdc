// ✅ 使用binding标签进行参数验证
type CreateOrderReq struct {
    ProductId uint64  `json:"product_id" binding:"required"`              // 商品ID，必填
    Quantity  int     `json:"quantity" binding:"required,min=1,max=999"`  // 数量，1-999
    Price     float64 `json:"price" binding:"required,gt=0"`              // 价格，大于0
    Remark    string  `json:"remark" binding:"omitempty,max=200"`         // 备注，最大200字符
}

// 自定义验证方法
func (req *CreateOrderReq) Validate() error {
    if req.ProductId == 0 {
        return errors.New("商品ID不能为空")
    }
    if req.Price < 0.01 || req.Price > 100000 {
        return errors.New("价格范围错误")
    }
    return nil
}
```

