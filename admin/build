#!/bin/bash

# 统一的前端分支版本
FRONTEND_BRANCH="1.1.1"

check_pnpm_installed() {
    if ! command -v pnpm &> /dev/null; then
        echo "pnpm 未安装，正在安装..."
        npm install -g pnpm
        if [ $? -ne 0 ]; then
            echo "pnpm 安装失败，请检查 npm 是否正确安装"
            return 1
        fi
        echo "pnpm 安装成功"
    fi
    return 0
}

check_pnpm_lock() {
    if [ ! -f "pnpm-lock.yaml" ]; then
        echo "错误: 未找到 pnpm-lock.yaml 文件，请使用 pnpm 作为包管理工具"
        return 1
    fi
    return 0
}

build() {
    # 检查并安装 pnpm
    if ! check_pnpm_installed; then
        return 1
    fi

    build_force=0
    build_env=all
    if [ "$1" == "force" ]; then
        echo "强制更新"
        build_force=1
    elif [ "$1" != "" ]; then
        echo "强制更新"
        build_force=1
        build_env=$1
    else
        echo "自动更新"
    fi

    # 平台端
    if [[ "$build_env" == 'all' || "$build_env" == 'admin' ]]; then
        cd view/admin
        pnpm install
        if ! check_pnpm_lock; then
            cd ../../
            return 1
        fi
        pnpm run build
        rm -rf ../../public/admin && cp -r ./admin ../../public/admin
        cd ../../
    fi

    # 店家后台
    if [[ "$build_env" == 'all' || "$build_env" == 'shop' ]]; then
        cd views/shop
        pnpm install
        if ! check_pnpm_lock; then
            cd ../../
            return 1
        fi
        pnpm run build
        rm -rf ../../public/shop && cp -r ./dist ../../public/shop
        cd ../../
    fi
}

#
build "$1"