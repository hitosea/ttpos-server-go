# 默认显示帮助信息
.DEFAULT_GOAL := help


# 捕获不存在的命令并显示帮助
%:
	@printf "\033[1;31mError:\033[0m make: *** No rule to make target '\033[1;33m$@\033[0m'. Stop.\n"
	@echo ""
	@printf "\033[1;37m🤔 您输入的命令 '\033[1;33m$@\033[1;37m' 不存在，请查看可用命令列表：\033[0m\n"
	@echo ""
	@make help

