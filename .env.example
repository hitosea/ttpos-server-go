# 谷歌云bucket - 安装包使用
GOOGLE_APPLICATION_BUCKET_NAME=
# 谷歌云bucket - 安装包使用 - 指定环境（Demo, Test, Prod）
GOOGLE_APPLICATION_BUCKET_ENV=Prod
# 谷歌云 - 上传图片的bucket （diacan-test）
GOOGLE_APPLICATION_UPLOADS_BUCKET_NAME=
# 谷歌云 - 上传图片的目录名称 （TTPOS-Test）
