# 服务ID
APP_ID=
# 服务器ID: 1到15台服务器
SERVER_ID=1
# 服务端口
NGINX_PORT=8888
NGINX_SSL_PORT=8443
# 服务端口
SERVER_PORT=8080
# debug - 调试模式；release - 生产模式；test - 测试模式
SERVER_MODE=release
# 域名
DOMAIN=

#数据库\Redis连接类型 ，本地-local , 外部-remote（集群）
DB_REDIS_TYPE=

#数据库配置
DB_HOST=db
DB_PORT=3306
DB_PORT_OPEN=13306
DB_USERNAME=ttpos
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_DATABASE=saas
DB_PREFIX=ttpos_
DB_SLOW_QUERY_TIME=

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 配置
JWT_SECRET="dkjhd00a08"
JWT_EXPIRE=7776000


# 原PHP配置
APP_DEBUG=false
DEFAULT_TIMEZONE=Asia/Shanghai

# 存储驱动程序上传图片等使用: google,local
STORAGE_DRIVER=local

# 有道翻译
YOUDAO_APP_KEY=
YOUDAO_SEC_KEY=

# 是否是云上部署
IS_CLOUD_DEPLOY=true

# 云平台的地址
