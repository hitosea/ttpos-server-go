{
    "swagger": "2.0",
    "info": {
        "description": "点餐系统服务端接口文档",
        "title": "jjjshop-server-go API",
        "contact": {},
        "version": "1.0"
    },
    "host": "127.0.0.1:8081",
    "basePath": "/",
    "paths": {
        "/cashier/passport/login": {
            "post": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "收银端"
                ],
                "summary": "登录",
                "parameters": [
                    {
                        "type": "string",
                        "description": "验证码sign",
                        "name": "X-SIGN",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "登录参数",
                        "name": "data",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/req.CashierLoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/dto.Response"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/resp.CashierLoginResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    }
                }
            }
        },
        "/cashier/passport/logout": {
            "post": {
                "security": [
                    {
                        "JwtToken": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "收银端"
                ],
                "summary": "退出登录",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.Response"
                        }
                    }
                }
            }
        },
        "/passport/captcha": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "通用"
                ],
                "summary": "获取验证码",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.Response"
                        }
                    }
                }
            }
        },
        "/passport/server-public-key": {
            "post": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "通用"
                ],
                "summary": "获取服务端公钥",
                "parameters": [
                    {
                        "type": "string",
                        "description": "客户端Id",
                        "name": "client_id",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "加密类型: pgp\\jsencrypt",
                        "name": "type",
                        "in": "query",
                        "required": true
                    },
                    {
                        "description": "获取公钥参数",
                        "name": "data",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/req.GetServerPublicKeyRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.Response"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "dto.Response": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "integer"
                },
                "data": {},
                "message": {
                    "type": "string"
                }
            }
        },
        "req.CashierLoginRequest": {
            "type": "object",
            "required": [
                "code",
                "device_id",
                "password",
                "user_name"
            ],
            "properties": {
                "code": {
                    "type": "string"
                },
                "device_id": {
                    "type": "string"
                },
                "device_ip": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                },
                "user_name": {
                    "type": "string"
                }
            }
        },
        "req.GetServerPublicKeyRequest": {
            "type": "object",
            "required": [
                "client_id",
                "type"
            ],
            "properties": {
                "client_id": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "pgp",
                        "jsencrypt"
                    ]
                }
            }
        },
        "resp.CashierLoginResponse": {
            "type": "object",
            "properties": {
                "token": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "JwtToken": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}