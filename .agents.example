# .agents.example
# 复制此文件为 .agents 并填入路径配置
# Agent 读取此文件来定位关联仓库，以便进行跨仓库的代码分析和协作


# === 相对路径（worktree 环境优先使用）===
# VibeKanban / Claude Code Desktop 使用 worktree 时，
# 多个仓库并列在同一父目录下，相对路径始终有效
FRONTEND_REL=../ttpos-flutter
BACKEND_REL=../ttpos-server-go
DOCS_REL=../ttpos-docs


# === 绝对路径（主仓库开发环境使用）===
# 当相对路径不可用时回退到绝对路径
# 例如: /Users/username/Projects/ttpos-server-go
FRONTEND_ABS=
BACKEND_ABS=
DOCS_ABS=
